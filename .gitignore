# Cloudflare API token for cert-manager (see certificateManager/base/cloudflare.env.example)
certificateManager/base/cloudflare.env

# Cloudflare Tunnel token for cloudflared (see cloudflared/base/cloudflared.env.example)
cloudflared/base/cloudflared.env

# Backblaze B2 application key for PostgreSQL backups (see postgresql/base/backblaze.env.example)
postgresql/base/backblaze.env

# Harbor admin and database passwords (generated by `make -C harbor prerequisites`)
harbor/base/harbor-db.env
harbor/base/harbor-admin.env

# Forgejo database/admin passwords and runner secrets (generated by `make -C forgejo prerequisites`)
forgejo/base/forgejo-db.env
forgejo/base/forgejo-admin.env
forgejo/base/forgejo-runner.env

# Helm charts that `kustomize build --enable-helm` downloads next to an overlay
charts/

# macOS Finder metadata
.DS_Store

# MiroTalk API secret (generated by `make -C brietzke-video prerequisites`)
brietzke-video/base/mirotalk.env
brietzke-video/base/basic-auth.env
brietzke-video/base/basic-auth.htpasswd
