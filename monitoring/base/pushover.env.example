# Pushover credentials for Alertmanager. Copy to pushover.env (git-ignored) and fill in:
#   user_key: your User Key, shown at the top of https://pushover.net after logging in
#   token:    an Application API Token, from https://pushover.net/apps/build (e.g. "olympians")
# Alertmanager reads them as files from Secret alertmanager-pushover.
user_key=REPLACE_ME
token=REPLACE_ME
