# Cloudflare Tunnel token for the remotely-managed olympians tunnel (brietzke.me).
# Zero Trust dashboard > Networks > Tunnels > <tunnel> > the token in the install command.
# This is NOT the DNS-01 API token in certificateManager/base/cloudflare.env; keep them separate.
# Copy to cloudflared.env (git-ignored) and replace the value.
TUNNEL_TOKEN=REPLACE_ME
