# Backblaze B2 application key for the Barman Cloud plugin (cluster00 backups).
# Create the key in B2 with "Read and Write" access restricted to the backup bucket.
# Copy to backblaze.env (git-ignored) and fill in both values.
#   ACCESS_KEY_ID      = the B2 keyID
#   ACCESS_SECRET_KEY  = the B2 applicationKey (shown only once, when the key is created)
ACCESS_KEY_ID=REPLACE_ME
ACCESS_SECRET_KEY=REPLACE_ME
