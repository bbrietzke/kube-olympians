# Created by `make -C brietzke-video prerequisites` as mirotalk.env (git-ignored).
# API_KEY_SECRET guards POST /api/v1/meeting and /api/v1/join (the "authorization" header).
# SESSION_SECRET signs MiroTalk's login session cookie.
# OIDC_CLIENT_ID / OIDC_CLIENT_SECRET: from the "MiroTalk" OIDC client in Pocket ID
# (https://auth.brietzke.me, callback URL https://video.brietzke.me/auth/callback).
API_KEY_SECRET=REPLACE_ME
SESSION_SECRET=REPLACE_ME
OIDC_CLIENT_ID=REPLACE_ME
OIDC_CLIENT_SECRET=REPLACE_ME
