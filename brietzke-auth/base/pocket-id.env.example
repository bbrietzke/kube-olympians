# Generated by `make -C brietzke-auth prerequisites` as pocket-id.env (git-ignored).
# ENCRYPTION_KEY encrypts Pocket ID's signing keys in the database: losing it invalidates every
# token and means re-creating the keys. Keep a copy with your other secrets.
ENCRYPTION_KEY=REPLACE_ME
DB_CONNECTION_STRING=postgres://pocketid:REPLACE_ME@cluster00-rw.db.svc:5432/pocketid?sslmode=require
